{
  "description": "Sea Trials plugin hooks \u2014 enforce the push gate (deny force pushes, and bare git push in older gated repos) and warm the model probe; block manual/--admin gh pr merge (use st-pr-merge)",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/session-start.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/guard-git-push.mjs\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/guard-gh-merge.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
