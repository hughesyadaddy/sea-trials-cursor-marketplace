{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node ./hooks/scripts/session-start.mjs",
        "timeout": 10
      }
    ],
    "beforeShellExecution": [
      {
        "command": "node ./hooks/scripts/guard-git-push.mjs",
        "matcher": "git[\\s\\S]*push",
        "timeout": 10,
        "failClosed": true
      }
    ]
  }
}
