{
  "mcpServers": {
    "atlassian": {
      "type": "http",
      "url": "https://mcp.atlassian.com/v2/mcp"
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@1.8.0",
        "--browserUrl",
        "http://127.0.0.1:9333",
        "--no-usage-statistics",
        "--no-performance-crux",
        "--no-category-performance",
        "--screenshotFormat",
        "webp",
        "--screenshotMaxWidth",
        "1280"
      ],
      "env": {
        "NODE_OPTIONS": "--max-old-space-size=8192",
        "CHROME_DEVTOOLS_MCP_NO_USAGE_STATISTICS": "1"
      }
    },
    "claude-code": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${CURSOR_PLUGIN_ROOT}/scripts/subscriptions/claude-code-mcp.mjs"
      ]
    }
  }
}
