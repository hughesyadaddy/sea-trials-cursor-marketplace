{
  "shards": [
    {
      "id": "sync-script",
      "paths": [
        "scripts/sync-vendor-plugins.mjs",
        "MARKETPLACE_IMPORTS.md",
        "PLUGIN_SOURCES.md"
      ],
      "dependsOn": [],
      "tier": "code",
      "summary": "Vendor sync script and its import docs"
    },
    {
      "id": "sea-trials-claude-plugin",
      "paths": [
        "plugins/sea-trials/.claude-plugin/",
        "plugins/sea-trials/.mcp.json",
        "plugins/sea-trials/hooks/"
      ],
      "dependsOn": [],
      "tier": "code"
    },
    {
      "id": "marketplace-root-ci",
      "paths": [
        ".claude-plugin/",
        ".github/workflows/",
        "README.md"
      ],
      "dependsOn": [],
      "tier": "mechanical"
    },
    {
      "id": "vendor-bump",
      "paths": [
        "imports/vgv-cursor-marketplace",
        "plugins/vgv-wingspan/",
        "plugins/vgv-ai-flutter-plugin/"
      ],
      "dependsOn": ["sync-script"],
